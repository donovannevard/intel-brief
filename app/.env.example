# =============================================================================
# intel-brief configuration
#
# Only the five USER_* values are required. Everything else has a working
# default, and with LLM_BASE_URL empty intel-brief runs as a reader and
# archive with no model involved anywhere.
# =============================================================================

# --- User context (drives Local and Country tab content) ---------------------
# Keep USER_LOCALITY in step with LOCAL_PLACES below and with the local feeds
# in feeds.yaml. All three have to agree or the Local tab stays empty.
USER_LOCALITY="London"
USER_REGION="Greater London"
USER_COUNTRY="United Kingdom"
USER_COUNTRY_CODE="GB"
USER_TIMEZONE="Europe/London"

# --- Where you live (required for a Local tab) --------------------------------
# The places you care about, comma-separated. There is NO default: an unset
# LOCAL_PLACES means nothing is filed as local.
#
# These do two jobs. They decide what counts as a Local story, and at install
# time they select which regional publishers get polled -- the installer
# matches them against the 41 UK regions in docs/uk-regions.md and writes the
# matching BBC region and papers into feeds.yaml.
LOCAL_PLACES="Manchester,Salford,Stockport"
# COUNTRY_TERMS=""
# STRONG_COUNTRY_TERMS=""

# --- Interpretation layer (optional) -----------------------------------------
# Leave LLM_BASE_URL empty to run intel-brief as a reader and archive:
# collection, full-text search, the geographic tabs and every computed markets
# figure work without a model. Set it to any OpenAI-compatible endpoint to
# switch on per-article analysis, the morning brief and the market narratives.
# The Status page always says which of the three states is in effect: off,
# configured-but-unreachable, or on.
#
#   LLM_BASE_URL="http://127.0.0.1:8090/v1"     llama-swap on this machine
#   LLM_BASE_URL="http://<lan-host>:11434/v1"   ollama on the LAN
#
# A 7B-class instruct model is the right size here. Measured on this workload,
# bigger models were both slower and LESS reliable at staying grounded in the
# text they were given.
LLM_BASE_URL=""
LLM_API_KEY="changeme"
LLM_MODEL="qwen2.5-7b"
LLM_CLASSIFY_MODEL="qwen2.5-3b"
LLM_MAX_CONCURRENT=2
LLM_TIMEOUT_SECONDS=180

# Releasing the GPU on pause. "/unload" is a llama-swap extension, not part of
# the OpenAI API -- empty means pausing just stops us making calls, which is
# correct for ollama or any endpoint that is not ours to unload.
#   auto  = derive llama-swap's /unload from LLM_BASE_URL
#   <url> = call this exactly
#   ""    = no unload call (default)
LLM_UNLOAD_URL=""

# --- Embeddings (optional) ---------------------------------------------------
# Drives story clustering. Without it, articles are never grouped across
# outlets and the "covered by N outlets" signal is unavailable. Often the same
# endpoint as above with a different model.
#   EMBEDDING_BASE_URL="http://127.0.0.1:8090/v1"
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY="changeme"
EMBEDDING_MODEL="nomic-embed-text"

# --- Storage -----------------------------------------------------------------
# intel.db is the irreplaceable one: RSS serves only what is currently live, so
# a day not collected is gone for good. markets.db regenerates from providers.
# install.sh rewrites both to point at <prefix>/data.
DB_PATH="./data/intel.db"
MARKETS_DB_PATH="./data/markets.db"
FEEDS_PATH="/srv/intel-brief/feeds.yaml"

# --- Markets -----------------------------------------------------------------
# Which crypto assets get a price instrument. Default: BTC.
# "BTC,XMR" adds Monero. Set to "" (explicitly empty) to drop the Crypto tab
# from the navigation entirely rather than render it blank.
CRYPTO_ASSETS="BTC"

MARKETS_INGEST_INTERVAL_HOURS=6

# Own budget so the market stages cannot run away the way analyze() once did.
# 15 min covers four tab briefs plus the correlation pass with room to spare.
MARKETS_LLM_TIME_BUDGET_SECONDS=900

# --- App ---------------------------------------------------------------------
# 127.0.0.1 binds to this machine only. Use 0.0.0.0 to reach the dashboard from
# the LAN -- there is no authentication anywhere in this app, so the network
# boundary is the security boundary.
DASHBOARD_HOST="127.0.0.1"
DASHBOARD_PORT=8300

# The comment MUST carry a contact URL. FRED's edge silently drops connections
# from a bare product token: every request hangs until it times out, while the
# identical request with a "+https://" URL returns in under a second. It fails
# as a timeout rather than a refusal, so it looks like a network fault from
# every angle except this one. config.py warns at startup if the URL is absent.
FETCH_USER_AGENT="PersonalIntelBrief/1.0 (+https://example.org)"
FETCH_DELAY_SECONDS=2

# --- Pipeline ----------------------------------------------------------------
# Runs once daily: discover -> extract -> analyze -> derive (brief), all
# sequential, all in one job. analyze is capped so the whole chain has a
# predictable, bounded runtime instead of taking however long it takes -- it
# was observed running 5-6 hours uncapped. Articles past the budget stay
# queued for the next run rather than being marked failed.
#
# Articles that sit unanalyzed past STALE_ARTICLE_HOURS are marked stale and
# dropped: they are not "yesterday's news" any more by the time they would get
# processed.
PIPELINE_RUN_TIME="05:30"
ANALYZE_TIME_BUDGET_SECONDS=3600
STALE_ARTICLE_HOURS=48

# The first date you actually expect coverage from. Articles before it are kept
# and searchable, they are just not counted as gaps to fill. Days lost before
# the archive was running properly cannot be recovered from RSS, so counting
# them as gaps means a backfill that retries forever and a Status page that
# never goes green.
ARCHIVE_START_DATE="2026-08-01"
BACKFILL_TIME_BUDGET_SECONDS=1800

# --- GPU contention guard ----------------------------------------------------
# Pause analysis while something else uses the GPU. Reads per-engine load from
# intel_gpu_top, so it is Intel-only.
#   auto = use it if intel_gpu_top is installed (default)
#   on   = require it
#   off  = never check
#
# Paused time is not counted against ANALYZE_TIME_BUDGET_SECONDS. The guard
# re-checks every GPU_PAUSE_CHECK_INTERVAL_SECONDS; if one run has been paused
# for longer than GPU_PAUSE_MAX_TOTAL_SECONDS in total it proceeds anyway,
# rather than risking never finishing.
#
# Requires: setcap cap_perfmon=ep $(which intel_gpu_top)
GPU_GUARD="auto"
GPU_PAUSE_CHECK_INTERVAL_SECONDS=120
GPU_PAUSE_MAX_TOTAL_SECONDS=14400
